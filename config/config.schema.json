{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lc-auto.app/schema/config.schema.json",
  "title": "Lc_auto Configuration Schema",
  "description": "Lc_auto 자동화 런처 설정 파일에 대한 JSON 스키마",
  "type": "object",
  "required": [
    "media",
    "automation",
    "paths",
    "alerts",
    "ui"
  ],
  "additionalProperties": false,
  "properties": {
    "media": {
      "type": "object",
      "description": "동영상 재생 경로 설정 (절대 경로 사용 권장)",
      "required": ["videoPath"],
      "additionalProperties": false,
      "properties": {
        "videoPath": {
          "type": "string",
          "description": "배경 설치 안내 영상의 절대 경로",
          "minLength": 1
        },
        "playerPath": {
          "type": "string",
          "description": "사용자 지정 플레이어 실행 파일 절대 경로 (빈 문자열은 기본 플레이어 사용)",
          "minLength": 0,
          "default": ""
        }
      }
    },
    "automation": {
      "type": "object",
      "description": "Lightroom Classic 자동화 항목 설정",
      "required": ["timeoutSec", "p1", "p2"],
      "additionalProperties": false,
      "properties": {
        "timeoutSec": {
          "type": "integer",
          "description": "단일 시도당 자동화 타임아웃(초)",
          "minimum": 10,
          "maximum": 120,
          "default": 30
        },
        "p1": {
          "type": "object",
          "description": "버튼 a(촬영 시작) 자동화 설정",
          "required": ["featureId"],
          "additionalProperties": false,
          "properties": {
            "featureId": {
              "type": "string",
              "description": "FeatureSelectorRegistry에 등록된 자동화 ID",
              "const": "start_photo"
            },
            "description": {
              "type": "string",
              "description": "자동화 설명",
              "minLength": 1
            }
          }
        },
        "p2": {
          "type": "object",
          "description": "버튼 b(내보내기) 자동화 설정",
          "required": ["featureId"],
          "additionalProperties": false,
          "properties": {
            "featureId": {
              "type": "string",
              "description": "FeatureSelectorRegistry에 등록된 자동화 ID",
              "const": "export_files"
            },
            "description": {
              "type": "string",
              "description": "자동화 설명",
              "minLength": 1
            }
          }
        }
      }
    },
    "paths": {
      "type": "object",
      "description": "폴더 경로 설정",
      "required": ["targetFolder"],
      "additionalProperties": false,
      "properties": {
        "targetFolder": {
          "type": "string",
          "description": "사진 저장 대상 폴더 절대 경로",
          "minLength": 1
        }
      }
    },
    "alerts": {
      "type": "array",
      "description": "HH:mm 기준 알림 팝업 스케줄",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["time", "message"],
        "additionalProperties": false,
        "properties": {
          "time": {
            "type": "string",
            "description": "알림 표시 시각 (HH:mm)",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "message": {
            "type": "string",
            "description": "알림 본문 메시지",
            "minLength": 1
          },
          "repeat": {
            "type": "string",
            "description": "알림 반복 주기",
            "enum": ["daily", "once"],
            "default": "daily"
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "description": "UI 동작 설정",
      "required": ["alwaysOnTop", "theme"],
      "additionalProperties": false,
      "properties": {
        "alwaysOnTop": {
          "type": "boolean",
          "description": "창 항상 위 고정 여부",
          "default": true
        },
        "theme": {
          "type": "string",
          "description": "ModernWpf 테마 모드",
          "enum": ["auto", "light", "dark"],
          "default": "auto"
        }
      }
    }
  }
}
